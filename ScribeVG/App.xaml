<Application x:Class="ScribeVG.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 漢字練習帳 look: cream paper, green frame, dotted cross guides -->
        <SolidColorBrush x:Key="CanvasBackground" Color="#FFFFFCF2"/>
        <SolidColorBrush x:Key="NotebookFrameBrush" Color="#FF3F8F5F"/>
        <SolidColorBrush x:Key="GridLineBrush" Color="#B03F8F5F"/>
        <SolidColorBrush x:Key="GuideCompletedBrush" Color="#66000000"/>
        <SolidColorBrush x:Key="GuideCurrentBrush" Color="#E0C0392B"/>
        <SolidColorBrush x:Key="GuideUpcomingBrush" Color="#33000000"/>
        <SolidColorBrush x:Key="InkBrush" Color="#FF1A1A1A"/>
    </Application.Resources>
</Application>
