<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce web install hosted at https://ppdac.ltd/scribevg/ (see docs/publishing.md).
  Build with Visual Studio's MSBuild (dotnet publish can't do ClickOnce):
    msbuild ScribeVG\ScribeVG.csproj /restore /t:Publish /p:Configuration=Release /p:PublishProfile=ClickOnce
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <PublishProtocol>ClickOnce</PublishProtocol>
    <!-- Local output folder; its contents are uploaded to ppdac.ltd/scribevg/. -->
    <PublishDir>bin\publish\clickonce\</PublishDir>
    <PublishUrl>bin\publish\clickonce\</PublishUrl>
    <!-- Where users install from and where installed copies look for updates. -->
    <InstallUrl>https://ppdac.ltd/scribevg/</InstallUrl>
    <Install>true</Install>
    <InstallFrom>Web</InstallFrom>
    <IsWebBootstrapper>true</IsWebBootstrapper>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <MapFileExtensions>true</MapFileExtensions>
    <GenerateManifests>true</GenerateManifests>

    <!-- Check for a newer version before the app starts. -->
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>

    <ProductName>ScribeVG</ProductName>
    <PublisherName>Louis Waweru</PublisherName>
    <SuiteName>ScribeVG</SuiteName>

    <!-- $(Version).<revision>: pass a higher /p:ApplicationRevision=N on every publish so installs update. -->
    <ApplicationVersion>$(Version).*</ApplicationVersion>
    <ApplicationRevision Condition="'$(ApplicationRevision)' == ''">0</ApplicationRevision>
    <IsRevisionIncremented>false</IsRevisionIncremented>

    <!-- Unsigned for now: Windows shows "Unknown publisher" on install. -->
    <SignManifests>false</SignManifests>
    <SignatureAlgorithm>(None)</SignatureAlgorithm>
  </PropertyGroup>
</Project>
