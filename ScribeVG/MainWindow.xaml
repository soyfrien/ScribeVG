<Window x:Class="ScribeVG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScribeVG — Kanji Practice"
        Height="820"
        Width="1100"
        MinHeight="640"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F0EA">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Square writing surface: guide overlay under an InkCanvas for stylus/touch -->
        <Viewbox Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="1090" Height="1090" Background="{StaticResource CanvasBackground}">
                <Border BorderBrush="#FF333333" BorderThickness="3">
                    <Grid>
                        <!-- KanjiVG coordinates are typically 109×109; we draw in 1090×1090 (×10) -->
                        <Canvas x:Name="GridCanvas" IsHitTestVisible="False"/>
                        <Canvas x:Name="GuideCanvas" IsHitTestVisible="False"/>
                        <InkCanvas x:Name="WritingCanvas"
                                   Background="Transparent"
                                   EditingMode="Ink"
                                   MoveEnabled="False"
                                   ResizeEnabled="False"
                                   StrokeCollected="WritingCanvas_StrokeCollected"/>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>

        <DockPanel Grid.Column="1" Margin="20,0,0,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="CharacterLabel"
                           Text="—"
                           FontSize="84"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,4"/>
                <TextBlock x:Name="StrokeProgressLabel"
                           Text="Load a parsed KanjiVG JSON folder to begin"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <Button Content="Open kanji folder…"
                        Height="44"
                        FontSize="16"
                        Margin="0,0,0,8"
                        Click="OpenFolder_Click"/>
                <Button Content="Open kanji file…"
                        Height="44"
                        FontSize="16"
                        Margin="0,0,0,16"
                        Click="OpenFile_Click"/>

                <CheckBox x:Name="ShowGuideCheck"
                          Content="Show stroke-order guide"
                          IsChecked="True"
                          FontSize="16"
                          Margin="0,0,0,16"
                          Checked="ShowGuideCheck_Changed"
                          Unchecked="ShowGuideCheck_Changed"/>

                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <Button Content="Undo"
                            Height="44"
                            FontSize="16"
                            Margin="0,0,6,8"
                            Click="Undo_Click"/>
                    <Button Content="Clear"
                            Height="44"
                            FontSize="16"
                            Margin="6,0,0,8"
                            Click="Clear_Click"/>
                    <Button Content="Previous"
                            Height="44"
                            FontSize="16"
                            Margin="0,0,6,0"
                            Click="Previous_Click"/>
                    <Button Content="Next"
                            Height="44"
                            FontSize="16"
                            Margin="6,0,0,0"
                            Click="Next_Click"/>
                </UniformGrid>
            </StackPanel>

            <TextBlock x:Name="StatusLabel"
                       DockPanel.Dock="Bottom"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Margin="0,16,0,0"
                       VerticalAlignment="Bottom"
                       Foreground="#FF333333"/>
        </DockPanel>
    </Grid>
</Window>
