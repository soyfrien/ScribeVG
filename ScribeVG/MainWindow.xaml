<Window x:Class="ScribeVG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScribeVG — Kanji Practice"
        Height="760"
        Width="1280"
        MinHeight="640"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FFE8F0E6"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="260"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="300" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: today's queue, practice buttons, and settings -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Today: spaced-repetition queue, unlocks and weak stroke types -->
                    <Border Background="#FFFFFFFF" CornerRadius="10" Padding="16,12"
                            BorderBrush="#22000000" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Today" FontSize="13" Foreground="#FF777777"/>
                            <TextBlock x:Name="TodayLabel" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                            <TextBlock x:Name="UnlockLabel" FontSize="15" TextWrapping="Wrap" Foreground="#FF2E7D32"
                                       Margin="0,4,0,0"/>
                            <TextBlock x:Name="WeakLabel" FontSize="13" TextWrapping="Wrap" Foreground="#FF555555"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Practice" FontSize="13" Foreground="#FF777777" Margin="0,16,0,8"/>
                    <Button Content="Study (due &amp; new kanji)"
                            ToolTip="Spaced-repetition reviews first, then new kanji once their parts are learned"
                            Height="44"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8"
                            Click="Study_Click"/>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="Open folder…" ToolTip="Free practice with a folder of KanjiVG files"
                                Height="44" FontSize="15" Margin="0,0,6,0" Click="OpenFolder_Click"/>
                        <Button Content="Open file…" ToolTip="Free practice with KanjiVG files"
                                Height="44" FontSize="15" Margin="6,0,0,0" Click="OpenFile_Click"/>
                    </UniformGrid>
                    <!-- Press and hold to peek at the guide without leaving it on (works with touch, pen or mouse) -->
                    <Button x:Name="PeekButton"
                            Content="Hold to peek at guide"
                            Height="48"
                            FontSize="16"
                            Margin="0,0,0,8"
                            PreviewMouseLeftButtonDown="Peek_Down"
                            PreviewMouseLeftButtonUp="Peek_Up"
                            LostMouseCapture="Peek_Up"
                            MouseLeave="Peek_Up"
                            TouchDown="Peek_Down"
                            TouchUp="Peek_Up"
                            TouchLeave="Peek_Up"/>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="Undo (~)" ToolTip="Undo last stroke (` or ~ key)"
                                Height="44"
                                FontSize="16"
                                Margin="0,0,6,8"
                                Click="Undo_Click"/>
                        <Button Content="Clear"
                                Height="44"
                                FontSize="16"
                                Margin="6,0,0,8"
                                Click="Clear_Click"/>
                        <Button Content="Previous"
                                Height="44"
                                FontSize="16"
                                Margin="0,0,6,0"
                                Click="Previous_Click"/>
                        <Button Content="Next"
                                Height="44"
                                FontSize="16"
                                Margin="6,0,0,0"
                                Click="Next_Click"/>
                    </UniformGrid>

                    <TextBlock Text="Settings" FontSize="13" Foreground="#FF777777" Margin="0,8,0,8"/>
                    <CheckBox x:Name="ShowGuideCheck"
                              IsChecked="False"
                              FontSize="15"
                              Margin="0,0,0,10"
                              Checked="ShowGuideCheck_Changed"
                              Unchecked="ShowGuideCheck_Changed">
                        <TextBlock Text="Show stroke guide (tap Space; hold to peek)" TextWrapping="Wrap"/>
                    </CheckBox>
                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox x:Name="AutoAdvanceCheck"
                                  Content="Auto-advance at"
                                  FontSize="15"
                                  VerticalAlignment="Center"
                                  ToolTip="After you finish a kanji with at least this average score, go to the next card automatically."
                                  Checked="AutoAdvance_Changed"
                                  Unchecked="AutoAdvance_Changed"/>
                        <ComboBox x:Name="AutoAdvanceCombo"
                                  Width="64"
                                  FontSize="15"
                                  Margin="8,0,6,0"
                                  VerticalAlignment="Center"
                                  SelectionChanged="AutoAdvance_Changed"/>
                        <TextBlock Text="or higher" FontSize="15" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <CheckBox x:Name="ReduceMotionCheck"
                              FontSize="15"
                              Margin="0,0,0,10"
                              Checked="ReduceMotion_Changed"
                              Unchecked="ReduceMotion_Changed">
                        <TextBlock Text="Reduce motion (no shake or bursts)" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="SheetModeCheck"
                              FontSize="15"
                              Margin="0,0,0,10"
                              ToolTip="Like a practice notebook row: trace the model, then a fading model, then write it 3 times from memory. Only the memory reps count toward the review."
                              Checked="SheetMode_Changed"
                              Unchecked="SheetMode_Changed">
                        <TextBlock Text="Sheet mode (write each kanji 6 times)" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="HideMeaningsCheck"
                              FontSize="15"
                              Margin="0,0,0,12"
                              ToolTip="Keep the meaning, readings and sentence translations hidden while you write. They show while the guide is on or Space is held, when you finish, or when you tap the hidden meaning."
                              Checked="HideMeanings_Changed"
                              Unchecked="HideMeanings_Changed">
                        <TextBlock Text="Hide meanings until done" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock x:Name="AudioStatusLabel" FontSize="12" TextWrapping="Wrap"
                               Foreground="#FF888888"/>
                    <Button Content="Set audio folder…" HorizontalAlignment="Left"
                            ToolTip="Choose the folder with Emi Asano's recordings (Umai Kanji Resources\Audio)"
                            FontSize="13" Padding="10,2" MinHeight="32" Margin="0,6,0,0"
                            Click="SetAudioFolder_Click"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- MIDDLE: writing square and sheet-mode strip, as large as fits -->
        <Viewbox Grid.Row="0" Grid.Column="1" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Grid x:Name="WritingSurface" Width="1090" Height="1090" Background="{StaticResource CanvasBackground}">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ShakeTransform"/>
                    </Grid.RenderTransform>
                    <Border BorderBrush="{StaticResource NotebookFrameBrush}" BorderThickness="12">
                        <Grid>
                            <!-- KanjiVG coordinates are typically 109×109; we draw in 1090×1090 (×10) -->
                            <Canvas x:Name="GridCanvas" IsHitTestVisible="False"/>
                            <Canvas x:Name="GuideCanvas" IsHitTestVisible="False"/>
                            <InkCanvas x:Name="WritingCanvas"
                                       Background="Transparent"
                                       EditingMode="Ink"
                                       MoveEnabled="False"
                                       ResizeEnabled="False"
                                       StrokeCollected="WritingCanvas_StrokeCollected"/>
                            <!-- Visual "haptics": miss flash and success particles, drawn over the ink -->
                            <Border x:Name="MissFlash" Background="#FFC62828" Opacity="0" IsHitTestVisible="False"/>
                            <Canvas x:Name="FxCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Sheet mode: a notebook row of 6 small boxes (one per rep) with a thin reading column -->
                <Grid x:Name="SheetStrip" Width="1090" Height="168" Margin="0,24,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,6,10,6" Background="{StaticResource CanvasBackground}"
                            BorderBrush="{StaticResource NotebookFrameBrush}" BorderThickness="3"
                            ToolTip="Reading">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                            <TextBlock x:Name="SheetReadingLabel" FontSize="30" TextAlignment="Center"
                                       Foreground="#FF2F6F47" LineHeight="34" LineStackingStrategy="BlockLineHeight"/>
                        </Viewbox>
                    </Border>
                    <UniformGrid x:Name="SheetBoxes" Grid.Column="1" Rows="1" Columns="6"/>
                </Grid>
            </StackPanel>
        </Viewbox>

        <!-- RIGHT: the current kanji, stroke feedback, and example sentences -->
        <ScrollViewer Grid.Row="0" Grid.Column="2" Margin="16,0,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="CharacterLabel"
                           Text="—"
                           FontSize="84"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,0"
                           Cursor="Hand"
                           ToolTip="Tap for an example sentence"
                           MouseLeftButtonUp="CharacterLabel_Click"
                           TouchUp="CharacterLabel_Click"/>
                <!-- Meaning and readings from KANJIDIC2 -->
                <TextBlock x:Name="MeaningLabel"
                           MouseLeftButtonUp="Meaning_Click"
                           TouchUp="Meaning_Click"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="ReadingsLabel"
                           FontSize="16"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#FF444444"/>
                <TextBlock x:Name="KanjiMetaLabel"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#FF888888"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="RadicalLabel"
                           FontSize="15"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#FF555555"
                           Margin="0,2,0,10"/>
                <TextBlock x:Name="StrokeProgressLabel"
                           Text="Open a folder of KanjiVG files to begin"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,16"/>

                <!-- Feedback panel: score for the last stroke plus a running tally for the kanji -->
                <Border Background="#FFFFFFFF" CornerRadius="10" Padding="16" Margin="0,0,0,0"
                        BorderBrush="#22000000" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Last stroke" FontSize="13" Foreground="#FF777777"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="ScoreLabel" Text="–" FontSize="44" FontWeight="Bold"
                                       Foreground="#FF333333" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="GradeLabel" Text="" FontSize="20" FontWeight="SemiBold"
                                       Margin="10,0,0,8" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <ProgressBar x:Name="ScoreBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                     Margin="0,4,0,8"/>
                        <TextBlock x:Name="BreakdownLabel" FontSize="13" Foreground="#FF555555"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TipLabel" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="This kanji" FontSize="13" Foreground="#FF777777"/>
                        <TextBlock x:Name="KanjiScoreLabel" Text="–" FontSize="22" FontWeight="SemiBold"
                                   Margin="0,2,0,4"/>
                        <WrapPanel x:Name="StrokeChips"/>
                    </StackPanel>
                </Border>

                <!-- Example sentences (Tatoeba via UmaiKanji) with Emi Asano's recordings -->
                <Border Background="#FFFFFFFF" CornerRadius="10" Padding="16,12" Margin="0,12,0,0"
                        BorderBrush="#22000000" BorderThickness="1">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Example sentences" FontSize="13" Foreground="#FF777777"
                                       DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <Button x:Name="MoreSentencesButton" Content="More ↻" DockPanel.Dock="Right"
                                    ToolTip="Show other example sentences for this kanji"
                                    FontSize="13" Padding="10,2" MinHeight="30"
                                    Visibility="Collapsed" Click="MoreSentences_Click"/>
                        </DockPanel>
                        <StackPanel x:Name="SentencePanel" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusLabel"
                   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,12,0,0"
                   Foreground="#FF333333"/>

        <!-- Speech bubble anchored to the big kanji (opened in code). -->
        <Popup x:Name="SentenceBubble"
               Grid.Row="0" Grid.ColumnSpan="3"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Custom"
               Focusable="False">
            <Grid x:Name="BubbleRoot" RenderTransformOrigin="1,0.16">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BubbleScale"/>
                </Grid.RenderTransform>
                <Grid Margin="8,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tail pointing at the kanji, tucked under the body's right edge. -->
                    <Path Grid.Column="1"
                          Fill="{StaticResource CanvasBackground}"
                          Stroke="{StaticResource NotebookFrameBrush}"
                          StrokeThickness="2.2"
                          StrokeLineJoin="Round"
                          Data="M 0,2 L 16,14 L 0,26 Z"
                          Width="16" Height="28" Stretch="Fill"
                          VerticalAlignment="Top" Margin="-4,28,2,0"
                          IsHitTestVisible="False"/>

                    <Border Grid.Column="0"
                            Background="{StaticResource CanvasBackground}"
                            BorderBrush="{StaticResource NotebookFrameBrush}"
                            BorderThickness="2.5"
                            CornerRadius="16"
                            Padding="16,14,16,12"
                            MinWidth="240" MaxWidth="380"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28"
                                              Direction="240" Color="#FF000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="BubbleEmptyLabel"
                                       FontSize="15" Foreground="#FF555555"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                            <StackPanel x:Name="BubbleBody">
                                <TextBlock x:Name="BubbleJapanese"
                                           FontSize="22" TextWrapping="Wrap"
                                           MouseLeftButtonUp="BubbleJapanese_Click"
                                           TouchUp="BubbleJapanese_Click"/>
                                <TextBlock x:Name="BubblePlaceholder"
                                           Text="Reading hidden — tap to show"
                                           FontSize="13" FontStyle="Italic"
                                           Foreground="#FF999999"
                                           Margin="0,6,0,0"
                                           Cursor="Hand"
                                           Visibility="Collapsed"
                                           MouseLeftButtonUp="BubblePlaceholder_Click"
                                           TouchUp="BubblePlaceholder_Click"/>
                                <TextBlock x:Name="BubbleReading"
                                           FontSize="13" Foreground="#FF666666"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="BubbleEnglish"
                                           FontSize="14" FontStyle="Italic"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed"/>
                                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                    <Button x:Name="BubbleReplayButton"
                                            Content="🔊" Width="36" Height="32"
                                            FontSize="14" Padding="0"
                                            Focusable="False"
                                            DockPanel.Dock="Left"
                                            Background="#FFF7F3E6"
                                            BorderBrush="{StaticResource NotebookFrameBrush}"
                                            ToolTip="Play Emi's reading"
                                            Click="BubbleReplay_Click"/>
                                    <Button x:Name="BubbleNextButton"
                                            Content="▶" Width="36" Height="32"
                                            FontSize="13" Padding="0"
                                            Focusable="False"
                                            DockPanel.Dock="Right"
                                            Background="#FFF7F3E6"
                                            BorderBrush="{StaticResource NotebookFrameBrush}"
                                            ToolTip="Next sentence"
                                            Click="BubbleNext_Click"/>
                                    <TextBlock x:Name="BubbleIndexLabel"
                                               FontSize="13" Foreground="#FF3F8F5F"
                                               VerticalAlignment="Center"
                                               Margin="10,0"
                                               DockPanel.Dock="Left"/>
                                </DockPanel>
                                <TextBlock x:Name="BubbleHint"
                                           FontSize="12" Foreground="#FF9A9A9A"
                                           Margin="0,6,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Popup>
    </Grid>
</Window>
