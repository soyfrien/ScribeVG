<Window x:Class="ScribeVG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScribeVG — Kanji Practice"
        Height="820"
        Width="1100"
        MinHeight="640"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F0EA"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Square writing surface: guide overlay under an InkCanvas for stylus/touch -->
        <Viewbox Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="WritingSurface" Width="1090" Height="1090" Background="{StaticResource CanvasBackground}">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ShakeTransform"/>
                </Grid.RenderTransform>
                <Border BorderBrush="#FF333333" BorderThickness="3">
                    <Grid>
                        <!-- KanjiVG coordinates are typically 109×109; we draw in 1090×1090 (×10) -->
                        <Canvas x:Name="GridCanvas" IsHitTestVisible="False"/>
                        <Canvas x:Name="GuideCanvas" IsHitTestVisible="False"/>
                        <InkCanvas x:Name="WritingCanvas"
                                   Background="Transparent"
                                   EditingMode="Ink"
                                   MoveEnabled="False"
                                   ResizeEnabled="False"
                                   StrokeCollected="WritingCanvas_StrokeCollected"/>
                        <!-- Visual "haptics": miss flash and success particles, drawn over the ink -->
                        <Border x:Name="MissFlash" Background="#FFC62828" Opacity="0" IsHitTestVisible="False"/>
                        <Canvas x:Name="FxCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>

        <DockPanel Grid.Column="1" Margin="20,0,0,0">
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="CharacterLabel"
                           Text="—"
                           FontSize="84"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
                <!-- Meaning and readings from KANJIDIC2 -->
                <TextBlock x:Name="MeaningLabel"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="ReadingsLabel"
                           FontSize="16"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#FF444444"/>
                <TextBlock x:Name="KanjiMetaLabel"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#FF888888"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="RadicalLabel"
                           FontSize="15"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#FF555555"
                           Margin="0,2,0,10"/>
                <TextBlock x:Name="StrokeProgressLabel"
                           Text="Open a folder of KanjiVG files to begin"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <Button Content="Study (due &amp; new kanji)"
                        ToolTip="Spaced-repetition reviews first, then new kanji once their parts are learned"
                        Height="44"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"
                        Click="Study_Click"/>
                <UniformGrid Columns="2" Margin="0,0,0,16">
                    <Button Content="Open folder…" ToolTip="Free practice with a folder of KanjiVG files"
                            Height="44" FontSize="15" Margin="0,0,6,0" Click="OpenFolder_Click"/>
                    <Button Content="Open file…" ToolTip="Free practice with KanjiVG files"
                            Height="44" FontSize="15" Margin="6,0,0,0" Click="OpenFile_Click"/>
                </UniformGrid>

                <!-- Press and hold to peek at the guide without leaving it on (works with touch, pen or mouse) -->
                <Button x:Name="PeekButton"
                        Content="Hold to peek at guide"
                        Height="52"
                        FontSize="16"
                        Margin="0,0,0,8"
                        PreviewMouseLeftButtonDown="Peek_Down"
                        PreviewMouseLeftButtonUp="Peek_Up"
                        LostMouseCapture="Peek_Up"
                        MouseLeave="Peek_Up"
                        TouchDown="Peek_Down"
                        TouchUp="Peek_Up"
                        TouchLeave="Peek_Up"/>
                <CheckBox x:Name="ShowGuideCheck"
                          Content="Show stroke guide (tap Space; hold to peek)"
                          IsChecked="False"
                          FontSize="16"
                          Margin="0,0,0,16"
                          Checked="ShowGuideCheck_Changed"
                          Unchecked="ShowGuideCheck_Changed"/>
                <StackPanel Orientation="Horizontal" Margin="0,-8,0,16">
                    <CheckBox x:Name="AutoAdvanceCheck"
                              Content="Auto-advance at"
                              FontSize="16"
                              VerticalAlignment="Center"
                              ToolTip="After you finish a kanji with at least this average score, go to the next card automatically."
                              Checked="AutoAdvance_Changed"
                              Unchecked="AutoAdvance_Changed"/>
                    <ComboBox x:Name="AutoAdvanceCombo"
                              Width="64"
                              FontSize="16"
                              Margin="8,0,6,0"
                              SelectionChanged="AutoAdvance_Changed"/>
                    <TextBlock Text="or higher" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <Button Content="Undo (~)" ToolTip="Undo last stroke (` or ~ key)"
                            Height="44"
                            FontSize="16"
                            Margin="0,0,6,8"
                            Click="Undo_Click"/>
                    <Button Content="Clear"
                            Height="44"
                            FontSize="16"
                            Margin="6,0,0,8"
                            Click="Clear_Click"/>
                    <Button Content="Previous"
                            Height="44"
                            FontSize="16"
                            Margin="0,0,6,0"
                            Click="Previous_Click"/>
                    <Button Content="Next"
                            Height="44"
                            FontSize="16"
                            Margin="6,0,0,0"
                            Click="Next_Click"/>
                </UniformGrid>

                <!-- Feedback panel: score for the last stroke plus a running tally for the kanji -->
                <Border Background="#FFFFFFFF" CornerRadius="10" Padding="16" Margin="0,16,0,0"
                        BorderBrush="#22000000" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Last stroke" FontSize="13" Foreground="#FF777777"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="ScoreLabel" Text="–" FontSize="44" FontWeight="Bold"
                                       Foreground="#FF333333" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="GradeLabel" Text="" FontSize="20" FontWeight="SemiBold"
                                       Margin="10,0,0,8" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <ProgressBar x:Name="ScoreBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                     Margin="0,4,0,8"/>
                        <TextBlock x:Name="BreakdownLabel" FontSize="13" Foreground="#FF555555"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TipLabel" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="This kanji" FontSize="13" Foreground="#FF777777"/>
                        <TextBlock x:Name="KanjiScoreLabel" Text="–" FontSize="22" FontWeight="SemiBold"
                                   Margin="0,2,0,4"/>
                        <WrapPanel x:Name="StrokeChips"/>
                    </StackPanel>
                </Border>

                <!-- Example sentences (Tatoeba via UmaiKanji) with Emi Asano's recordings -->
                <Border Background="#FFFFFFFF" CornerRadius="10" Padding="16,12" Margin="0,12,0,0"
                        BorderBrush="#22000000" BorderThickness="1">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Example sentences" FontSize="13" Foreground="#FF777777"
                                       DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <Button x:Name="MoreSentencesButton" Content="More ↻" DockPanel.Dock="Right"
                                    ToolTip="Show other example sentences for this kanji"
                                    FontSize="13" Padding="10,2" MinHeight="30"
                                    Visibility="Collapsed" Click="MoreSentences_Click"/>
                        </DockPanel>
                        <StackPanel x:Name="SentencePanel" Margin="0,6,0,0"/>
                        <TextBlock x:Name="AudioStatusLabel" FontSize="12" TextWrapping="Wrap"
                                   Foreground="#FF888888" Margin="0,6,0,0"/>
                        <Button Content="Set audio folder…" HorizontalAlignment="Left"
                                ToolTip="Choose the folder with Emi Asano's recordings (Umai Kanji Resources\Audio)"
                                FontSize="13" Padding="10,2" MinHeight="32" Margin="0,6,0,0"
                                Click="SetAudioFolder_Click"/>
                    </StackPanel>
                </Border>

                <!-- Today: spaced-repetition queue, unlocks and weak stroke types -->
                <Border Background="#FFFFFFFF" CornerRadius="10" Padding="16,12" Margin="0,12,0,0"
                        BorderBrush="#22000000" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Today" FontSize="13" Foreground="#FF777777"/>
                        <TextBlock x:Name="TodayLabel" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                        <TextBlock x:Name="UnlockLabel" FontSize="15" TextWrapping="Wrap" Foreground="#FF2E7D32"
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="WeakLabel" FontSize="13" TextWrapping="Wrap" Foreground="#FF555555"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="StatusLabel"
                       DockPanel.Dock="Bottom"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Margin="0,16,0,0"
                       VerticalAlignment="Bottom"
                       Foreground="#FF333333"/>
        </DockPanel>
    </Grid>
</Window>
